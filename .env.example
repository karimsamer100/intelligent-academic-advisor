# Copy to .env and adjust. Never commit the real .env file.

# --- Application -----------------------------------------------------------
APP_ENV=development
APP_NAME=Local Intelligent Academic Advisor
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# Used when running the backend / alembic / pytest directly on your machine.
# Inside docker compose this value is ignored and rebuilt from POSTGRES_*
# (host "postgres").
DATABASE_URL=postgresql+psycopg://advisor:change_me@localhost:5432/advisor

# Used by the postgres container and to build the URL when DATABASE_URL is empty.
POSTGRES_DB=advisor
POSTGRES_USER=advisor
POSTGRES_PASSWORD=1234
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- RAG -------------------------------------------------------------------
RAG_TOP_K=5
DOCUMENTS_PATH=./data/documents

# --- Logging / HTTP --------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
