# Application
APP_ENV=development
APP_NAME=Local Intelligent Academic Advisor
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL / pgvector
POSTGRES_DB=advisor
POSTGRES_USER=advisor
POSTGRES_PASSWORD=advisor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://advisor:advisor@localhost:5432/advisor

# Academic Data Foundation (local Python runs)
ACADEMIC_DATA_FOUNDATION_PATH=../data/academic_foundation
DOCUMENTS_PATH=../data/academic_foundation/raw/documents

# Local multilingual embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
# EMBEDDING_CACHE_DIR=../models/embedding-cache

# RAG chunking
CHUNK_SIZE=1400
CHUNK_OVERLAP=180
CHUNK_MIN_CHARS=80

# Retrieval
RAG_TOP_K=5
RAG_MAX_TOP_K=20
# Calibrate this on the chosen model/eval set before enabling, e.g. 0.30
RAG_MIN_SCORE=

# Ingestion
PIPELINE_VERSION=rag-v0.1.0
PRESERVE_RAW_EXTRACTION=true
RAW_EXTRACT_DIR=../data/rag_debug/extracted
