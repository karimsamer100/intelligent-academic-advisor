# Copy to .env and adjust. Never commit the real .env file.

# --- Application -----------------------------------------------------------
APP_ENV=development
APP_NAME=Local Intelligent Academic Advisor
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# Used when running the backend / alembic / pytest directly on your machine.
# Inside docker compose this value is ignored and rebuilt from POSTGRES_*
# (host "postgres").
DATABASE_URL=postgresql+psycopg://advisor:1234@localhost:5432/advisor

# Used by the postgres container and to build the URL when DATABASE_URL is empty.
POSTGRES_DB=advisor
POSTGRES_USER=advisor
POSTGRES_PASSWORD=1234
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- RAG -------------------------------------------------------------------
RAG_TOP_K=5
RAG_MAX_TOP_K=20
# Leave blank until unsupported-query threshold calibration is complete.
RAG_MIN_SCORE=

# --- Academic data / embeddings -------------------------------------------
ACADEMIC_DATA_FOUNDATION_PATH=../data/academic
DOCUMENTS_PATH=../data/academic/raw/documents
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
# EMBEDDING_CACHE_DIR=../data/model-cache

# --- RAG chunking ----------------------------------------------------------
CHUNK_SIZE=1400
CHUNK_OVERLAP=180
CHUNK_MIN_CHARS=80

# --- RAG ingestion ---------------------------------------------------------
PIPELINE_VERSION=rag-v0.1.0
PRESERVE_RAW_EXTRACTION=true
RAW_EXTRACT_DIR=../data/rag_debug/extracted

# --- Logging / HTTP --------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
